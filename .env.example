# Supabase Configuration (server-side only; never expose service-role key to client)
SUPABASE_URL="MY_SUPABASE_URL"
SUPABASE_ANON_KEY="MY_SUPABASE_ANON_KEY"
SUPABASE_SERVICE_ROLE_KEY="MY_SUPABASE_SERVICE_ROLE_KEY"

# Account Creation Rate Limit (requests per minute per IP)
RATE_LIMIT_MAX_REGISTRATIONS=10
